rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwnerEmail() {
      return isAuthenticated() && (
        (request.auth.token.email != null && request.auth.token.email.matches('(?i)^(egecagant@gmail\\.com|batuhanesirger@gmail\\.com)$'))
      );
    }

    function isAdmin() {
      return isOwnerEmail() || (
        isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Categories catalog: Public read, Admin write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Products catalog: Public read, Admin write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Banners slider: Public read, Admin write
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: Clients cannot create orders directly (all order creations handled by server Admin SDK).
    // Owner of order or Admin can read; Admin can update/delete
    match /orders/{orderId} {
      allow create: if false;
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Contact messages: Anyone can create; Only admin can read, update, or delete
    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Discount Coupons: Public read to allow coupon verification at checkout, Admin write
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users profiles:
    // - Read: User can read own profile, Admin can read all
    // - Create: Authenticated user can create their own profile (cannot self-assign admin unless owner/admin)
    // - Update: User can update own profile WITHOUT changing their role; Admin can update any field/role
    // - Delete: Only admin can delete user documents
    match /users/{userId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow create: if isAuthenticated() && request.auth.uid == userId && (
        request.resource.data.role == 'customer' || isOwnerEmail() || isAdmin()
      );
      allow update: if isAdmin() || (
        isAuthenticated() && 
        request.auth.uid == userId && 
        request.resource.data.role == resource.data.role
      );
      allow delete: if isAdmin();
    }

    // Site settings & text customization: Public read, Admin write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

