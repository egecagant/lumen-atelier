{
  "entities": {
    "category": {
      "title": "Category",
      "description": "Lighting category entity",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "order": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["name", "slug"]
    },
    "product": {
      "title": "Product",
      "description": "Lighting product item",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "price": { "type": "number" },
        "compareAtPrice": { "type": "number" },
        "shortDescription": { "type": "string" },
        "description": { "type": "string" },
        "stockStatus": { "type": "string" },
        "stockQuantity": { "type": "number" },
        "dimensions": { "type": "string" },
        "material": { "type": "string" },
        "lightSpecs": { "type": "string" },
        "energyClass": { "type": "string" },
        "featured": { "type": "boolean" },
        "isNewArrival": { "type": "boolean" },
        "images": { "type": "array" },
        "createdAt": { "type": "number" }
      },
      "required": ["name", "price", "categoryId"]
    },
    "banner": {
      "title": "Banner",
      "description": "Hero slider banner",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "imageUrl": { "type": "string" },
        "link": { "type": "string" },
        "ctaText": { "type": "string" },
        "order": { "type": "number" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["title", "imageUrl"]
    },
    "order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "customerName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "object" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "shipping": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "paymentId": { "type": "string" },
        "iyzicoPaymentId": { "type": "string" },
        "iyzicoToken": { "type": "string" },
        "notes": { "type": "string" },
        "adminNote": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["customerName", "email", "total", "items"]
    },
    "message": {
      "title": "Message",
      "description": "Contact and bespoke inquiry message",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["fullName", "email", "message"]
    },
    "coupon": {
      "title": "Coupon",
      "description": "Discount coupon code for store checkout",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "description": { "type": "string" },
        "discountType": { "type": "string", "enum": ["percentage", "fixed"] },
        "discountValue": { "type": "number" },
        "minOrderAmount": { "type": "number" },
        "maxDiscountAmount": { "type": "number" },
        "active": { "type": "boolean" },
        "usageCount": { "type": "number" },
        "usageLimit": { "type": "number" },
        "expiresAt": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["code", "discountType", "discountValue", "active"]
    },
    "user": {
      "title": "User",
      "description": "User profile entity",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "phone": { "type": "string" },
        "savedAddresses": { "type": "array" },
        "role": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["uid", "email"]
    },
    "settings": {
      "title": "SiteSettings",
      "description": "Global website editable texts and configurations",
      "type": "object",
      "properties": {
        "brandName": { "type": "string" },
        "brandTagline": { "type": "string" },
        "brandDescription": { "type": "string" },
        "brandBadge": { "type": "string" },
        "categorySectionBadge": { "type": "string" },
        "categorySectionTitle": { "type": "string" },
        "categorySectionDescription": { "type": "string" },
        "productSectionBadge": { "type": "string" },
        "productSectionTitle": { "type": "string" },
        "productSectionDescription": { "type": "string" },
        "contactBadge": { "type": "string" },
        "contactTitle": { "type": "string" },
        "contactDescription": { "type": "string" },
        "contactAddressTitle": { "type": "string" },
        "contactAddressText": { "type": "string" },
        "contactEmailTitle": { "type": "string" },
        "contactEmailText": { "type": "string" },
        "contactPhoneTitle": { "type": "string" },
        "contactPhoneText": { "type": "string" },
        "contactWorkingHoursTitle": { "type": "string" },
        "contactWorkingHoursText": { "type": "string" },
        "footerBrandText": { "type": "string" },
        "footerQualityBadge": { "type": "string" },
        "footerCopyright": { "type": "string" },
        "announcementText": { "type": "string" },
        "announcementActive": { "type": "boolean" }
      }
    }
  },
  "firestore": {
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/category" },
      "description": "Product categories"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/product" },
      "description": "Product items catalog"
    },
    "/banners/{bannerId}": {
      "schema": { "$ref": "#/entities/banner" },
      "description": "Hero slider banners"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/order" },
      "description": "Customer purchase orders"
    },
    "/messages/{messageId}": {
      "schema": { "$ref": "#/entities/message" },
      "description": "Contact and bespoke inquiry messages"
    },
    "/coupons/{couponId}": {
      "schema": { "$ref": "#/entities/coupon" },
      "description": "Promotional discount codes and coupons"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/user" },
      "description": "Registered user accounts"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/settings" },
      "description": "Customizable site text and content settings"
    }
  }
}
