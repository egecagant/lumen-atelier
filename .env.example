# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# iyzico Payment Gateway Configuration
# Server secrets for iyzico Node.js SDK
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"

# Resend Email Configuration (for automated order confirmation emails)
# Get your API key for free at https://resend.com/api-keys
RESEND_API_KEY=
# Sender email address. If domain is verified in Resend, use your domain (e.g. "LUMEN ATELIER <siparis@lumenlatelier.com>").
# For testing without domain verification, leave empty to default to "LUMEN ATELIER <onboarding@resend.dev>".
RESEND_FROM_EMAIL="LUMEN ATELIER <onboarding@resend.dev>"
# Admin email receiving BCC of all orders (defaults to egecagant@gmail.com)
ADMIN_NOTIFICATION_EMAIL="egecagant@gmail.com"

# Client-Side API Base URL (optional, if frontend is hosted separately on Cloudflare or custom CDN)
# Example: https://ais-dev-uweusehq6santj6vtwicl6-785191501269.europe-west2.run.app
VITE_API_BASE_URL=

# Firebase Admin Service Account credentials JSON string
# Required for server-side Firebase Admin SDK to bypass client security rules.
# Can be set via AI Studio Settings / Secrets panel or Cloud Run environment variables.
FIREBASE_SERVICE_ACCOUNT=

